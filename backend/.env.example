# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (or any PostgreSQL URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Name of the storage bucket for PDF uploads (create this in your Supabase dashboard)
SUPABASE_STORAGE_BUCKET=annual-reports

# ─────────────────────────────────────────────────────────────────────────────
# Model providers — OpenAI-compatible chat + embeddings
#
# The NVIDIA_* names are historical; build.nvidia.com is just the default.
# Any /v1-compatible endpoint works (hosted NIM, self-hosted NIM, vLLM,
# gateway, ...), and NO model id is hardcoded or validated against a catalog.
# To change models, edit this file and restart — see the "model profile"
# checklist below. Get an NVIDIA key on any model page at build.nvidia.com
# ("Get API Key", starts with `nvapi-`); one key serves chat + embeddings.
# ─────────────────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY
# No client rewrites this from a model table — if your model lives on a
# different endpoint, set that endpoint here explicitly.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Chat model profile (change ALL of these together) ───────────────────────
# Exact id the endpoint serves. Newer ids (e.g. nvidia/nemotron-3.5-bolt-e4b)
# are fine: the client does not consult a known-model table.
NVIDIA_CHAT_LLM_NAME=meta/llama-3.3-70b-instruct
# Declared capabilities. LLMMetadata needs real booleans; no client infers
# them from the model name any more. ReAct is prompt-based → tools=false.
NVIDIA_CHAT_IS_CHAT_MODEL=true
NVIDIA_CHAT_IS_FUNCTION_CALLING_MODEL=false
# Prompt sizing / reply cap. Defaults match the model above; look up the new
# model's context length and max output tokens when you swap it, or synthesis
# will ask for too little (or too much) context.
NVIDIA_CHAT_CONTEXT_WINDOW=131072
NVIDIA_CHAT_MAX_TOKENS=4096
NVIDIA_CHAT_TIMEOUT=120

# ── Embedding model profile ─────────────────────────────────────────────────
NVIDIA_EMBEDDING_MODEL_NAME=nvidia/nemotron-3-embed-1b
# nim    = send NVIDIA's `input_type` (passage/query) + `truncate` fields.
# openai = plain /v1/embeddings request (no NIM-only fields).
NVIDIA_EMBEDDING_REQUEST_STYLE=nim
NVIDIA_EMBEDDING_TRUNCATE=END
# Optional reduced output size for models that support it. MUST equal
# VECTOR_STORE_EMBED_DIM below (validated at boot). Leave unset for native.
# NVIDIA_EMBEDDING_DIMENSIONS=2048

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
VECTOR_STORE_TABLE_NAME=pg_vector_store
# MUST equal the embedding model's output size (nemotron-3-embed-1b = 2048).
# ⚠️ CHANGING THE EMBEDDING MODEL OR ITS DIMENSION invalidates every stored
# vector. Drop the table and re-index:
#   DROP TABLE IF EXISTS data_pg_vector_store;   -- then restart the backend
#   POST /api/document/{id}/reindex             -- for every document
# Startup refuses to boot against a table with a different dimension.
VECTOR_STORE_EMBED_DIM=2048
LOG_LEVEL=DEBUG
# Origins allowed to call the API from a browser. With the Vite dev proxy and the
# production reverse proxy the frontend is same-origin, so this only matters when
# the UI is served from another host.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# Uploads
MAX_UPLOAD_MB=50

# Ingestion
# false = accept uploads but do not index them (documents stay in "uploaded").
# Uploads are indexed by a background job; the client polls
# GET /api/document/{id} for status/progress.
INGESTION_ENABLED=true

# Auth / tenancy (not implemented yet — every endpoint is public while false)
AUTH_ENABLED=false
# Labels a seeded/demo deployment for the UI
DEMO_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# Optional observability (leave blank to disable)
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
